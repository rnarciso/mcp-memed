# ---- Ambiente Memed ----------------------------------------------------
# homolog (testes, sem validade legal) | prod (documentos com validade legal)
MEMED_ENV=homolog

# Chaves de PARCEIRO (api-key / secret-key). Em homologação a Memed publica
# chaves de teste fixas na documentação (doc.memed.com.br > Primeiros passos).
# As de produção são liberadas pela Memed após a homologação.
MEMED_API_KEY=
MEMED_SECRET_KEY=

# Opcional: sobrescrever URLs (conferir na documentação da Memed)
# MEMED_API_BASE_URL=https://sandbox.api.memed.com.br/v1
# MEMED_SCRIPT_URL=https://sandbox.memed.com.br/modulos/plataforma.sinapse-prescricao/build/sinapse-prescricao.min.js

# ---- Prescritor (você) --------------------------------------------------
# Identificador estável do médico no seu sistema (ex.: crm-sp-123456)
MEMED_PRESCRIBER_EXTERNAL_ID=

# Usados só pelo comando "registrar-prescritor"
MEMED_PRESCRIBER_NOME=
MEMED_PRESCRIBER_SOBRENOME=
MEMED_PRESCRIBER_CPF=
MEMED_PRESCRIBER_DATA_NASCIMENTO=   # dd/mm/aaaa
MEMED_PRESCRIBER_CRM=
MEMED_PRESCRIBER_UF=
MEMED_PRESCRIBER_EMAIL=
MEMED_PRESCRIBER_TELEFONE=
MEMED_PRESCRIBER_SEXO=              # M | F
MEMED_PRESCRIBER_CIDADE=
MEMED_PRESCRIBER_ESPECIALIDADE=

# ---- Servidor MCP --------------------------------------------------------
# URL pela qual VOCÊ abre as páginas de revisão no navegador
PUBLIC_BASE_URL=http://dev-docker.lan:8765
# Token exigido dos clientes MCP (Authorization: Bearer ...). Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Hosts aceitos no cabeçalho Host (proteção contra DNS rebinding). Ex.: dev-docker.lan:8765,192.168.1.50:8765
ALLOWED_HOSTS=
HOST=0.0.0.0
PORT=8765
DATA_DIR=/data
